# API base URL (include /api/v1 if your backend uses that prefix)
VITE_API_BASE_URL=YOUR_API_BASE_URL

# Same Google OAuth client ID as GOOGLE_CLIENT_ID in backend .env
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Gate 1 (Stage 1) assessment APIs. Set to "true" for live endpoints; omit or "false" for in-app mocks.
VITE_GATE1_API_ENABLED=false

# Anti-cheat tab switch enforcement. Set to "true" to enable tab-switch cheat warnings & auto-submits; "false" for dev debugging.
VITE_ENABLE_ANTI_CHEAT_TAB_SWITCH=false

# Anti-cheat paste blocking enforcement. Set to "true" to block copy/paste in text areas; "false" for dev debugging.
VITE_ENABLE_ANTI_CHEAT_PASTE=false


